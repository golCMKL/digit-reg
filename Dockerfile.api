FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY app/server.py .
COPY app/init_db.py .
COPY app/start.sh .
COPY app/models/ ./models/

COPY app/models/digit_cnn.onnx .
COPY app/models/digit_cnn.onnx.data .
COPY app/models/digit_cnn_int8.onnx .

RUN chmod +x start.sh

ENV MODEL_BACKEND=onnx-int8

EXPOSE 5000

CMD ["./start.sh"]